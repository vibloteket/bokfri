<jasperTemplate>
	<style name="BokfriBase" fontName="Bokfri Sans" fontSize="9.0"/>
	<style name="BokfriSection" style="BokfriBase" fontSize="10.0" bold="true"/>
	<style name="BokfriLabel" style="BokfriBase" forecolor="#555555" fontSize="8.0"/>
	<style name="BokfriValue" style="BokfriBase" fontSize="9.0"/>
	<style name="BokfriValueRight" style="BokfriValue" hTextAlign="Right"/>
	<style name="BokfriCompactValueRight" style="BokfriValueRight" fontSize="8.0"/>
	<style name="BokfriSectionValue" style="BokfriSection" hTextAlign="Right"/>
	<style name="BokfriNumber" style="BokfriValueRight"/>
	<style name="BokfriTotalLabel" style="BokfriLabel" fontSize="7.0"/>
	<style name="BokfriTotalValue" style="BokfriNumber" fontSize="10.0"/>
</jasperTemplate>
