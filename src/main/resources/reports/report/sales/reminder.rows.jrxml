<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="ReminderRows">
    <template><![CDATA["reports/report/styles/bokfri.jrtx"]]></template>

    <parameter name="reminder.reminderfee" class="java.math.BigDecimal"/>
    <parameter name="reminder.saldo.sum" class="java.math.BigDecimal"/>
    <parameter name="reminder.interest.sum" class="java.math.BigDecimal"/>
    <parameter name="customer.currency" class="java.lang.String"/>

    <field name="invoice.number"        class="java.lang.String"/>
    <field name="invoice.date"          class="java.lang.String"/>
    <field name="invoice.duedate"       class="java.lang.String"/>
    <field name="invoice.duedays"       class="java.lang.Integer"/>
    <field name="invoice.numreminders"  class="java.lang.Integer"/>
    <field name="invoice.delayinterest" class="java.math.BigDecimal"/>
    <field name="invoice.saldo"         class="java.math.BigDecimal"/>
    <field name="invoice.delayfee"      class="java.math.BigDecimal"/>


    <variable name="delayfee.sum" class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression>
            <![CDATA[$F{invoice.delayfee}]]>
        </variableExpression>
        <initialValueExpression>
            <![CDATA[new BigDecimal(0.0)]]>
        </initialValueExpression>
    </variable>

    <variable name="saldo.sum"  class="java.math.BigDecimal" calculation="Sum" resetType="Report">
        <variableExpression>
            <![CDATA[$F{invoice.saldo}]]>
        </variableExpression>
        <initialValueExpression>
            <![CDATA[new BigDecimal(0.0)]]>
        </initialValueExpression>
    </variable>


    <columnHeader>
        <band height="20" isSplitAllowed="false">
            <staticText>
                <reportElement style="BokfriSection" x="0" y="3" width="510" height="14"/>
                <text><![CDATA[Fakturauppgifter]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="19" width="510" height="1"/>
                <graphicElement pen="Thin"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="92" isSplitAllowed="false">
            <printWhenExpression><![CDATA[$F{invoice.duedays}.intValue() > 0]]></printWhenExpression>

            <!-- One vertically flowing information block per invoice. -->
            <textField>
                <reportElement style="BokfriLabel" x="0" y="5" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.1}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="BokfriCompactValueRight" x="115" y="4" width="135" height="14"/>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{invoice.number}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="BokfriLabel" x="0" y="23" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.2}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="BokfriValueRight" x="115" y="23" width="135" height="13"/>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{invoice.date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="BokfriLabel" x="265" y="23" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.3}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="BokfriValueRight" x="380" y="23" width="130" height="13"/>
                <textFieldExpression class="java.lang.String"><![CDATA[$F{invoice.duedate}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="BokfriLabel" x="0" y="40" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.4}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="BokfriNumber" x="115" y="40" width="135" height="13"/>
                <textFieldExpression class="java.lang.Integer"><![CDATA[$F{invoice.duedays}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="BokfriLabel" x="265" y="40" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.5}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="BokfriNumber" x="380" y="40" width="130" height="13"/>
                <textFieldExpression class="java.lang.Integer"><![CDATA[$F{invoice.numreminders}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="BokfriLabel" x="0" y="57" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.6}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00' %'" isBlankWhenNull="true">
                <reportElement style="BokfriNumber" x="115" y="57" width="135" height="13"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{invoice.delayinterest}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="BokfriLabel" x="265" y="57" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.7}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement style="BokfriNumber" x="380" y="57" width="130" height="13"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{invoice.saldo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="BokfriLabel" x="265" y="74" width="110" height="13"/>
                <textFieldExpression><![CDATA[$R{reminderreport.column.8}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement style="BokfriNumber" x="380" y="74" width="130" height="13"/>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{invoice.delayfee}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="91" width="510" height="1"/>
                <graphicElement pen="Thin"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="12">
            <!-- Number -->
            <textField>
                <reportElement x="0" y="0" width="510" height="12"/>

                <box bottomBorder="Thin" borderColor="#000000" />

                <textElement textAlignment="Right" verticalAlignment="Bottom">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$R{reminderreport.continuing}]]>
                </textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <lastPageFooter>
        <band height="0">
        </band>
    </lastPageFooter>


    <summary>
        <band height="50" isSplitAllowed="false">
            <!-- Twelve points are approximately four millimetres of spacing. -->
            <frame>
                <reportElement x="0" y="12" width="510" height="38"/>
                <box border="Thin" borderColor="#000000"/>
                <line><reportElement x="127" y="0" width="1" height="38"/><graphicElement pen="Thin"/></line>
                <line><reportElement x="254" y="0" width="1" height="38"/><graphicElement pen="Thin"/></line>
                <line><reportElement x="381" y="0" width="1" height="38"/><graphicElement pen="Thin"/></line>
                <textField isBlankWhenNull="true"><reportElement style="BokfriTotalLabel" x="5" y="3" width="117" height="10"/><textFieldExpression><![CDATA[$R{reminderreport.totalreminderfee}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true" pattern="#,##0.00"><reportElement style="BokfriTotalValue" x="12" y="20" width="103" height="14"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{reminder.reminderfee}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement style="BokfriTotalLabel" x="132" y="3" width="117" height="10"/><textFieldExpression><![CDATA[$R{reminderreport.delayfee}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="BokfriTotalValue" x="139" y="20" width="103" height="14"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{reminder.interest.sum}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement style="BokfriTotalLabel" x="259" y="3" width="117" height="10"/><textFieldExpression><![CDATA[$R{reminderreport.saldosum}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="BokfriTotalValue" x="266" y="20" width="103" height="14"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{reminder.saldo.sum}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement style="BokfriTotalLabel" x="386" y="3" width="117" height="10"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$R{reminderreport.totalsum}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="BokfriTotalValue" x="393" y="20" width="82" height="14"/><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{reminder.interest.sum}.add($P{reminder.saldo.sum}).add($P{reminder.reminderfee})]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement style="BokfriValue" x="478" y="20" width="27" height="14"/><textFieldExpression><![CDATA[$P{customer.currency}]]></textFieldExpression></textField>
            </frame>
        </band>
    </summary>

</jasperReport>
