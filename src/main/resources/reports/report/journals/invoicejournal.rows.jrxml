<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="InvoiceJournalRows" resourceBundle="book">

    <parameter name="invoice.number" class="java.lang.Integer"/>
    <parameter name="invoice.sum" class="java.math.BigDecimal"/>
    <parameter name="invoice.tax" class="java.math.BigDecimal"/>
    <parameter name="invoice.currencyrate" class="java.math.BigDecimal"/>
    <parameter name="invoice.localsum" class="java.math.BigDecimal"/>

    <field name="row.account"          class="java.lang.Integer"/>
    <field name="row.description"      class="java.lang.String"/>
    <field name="row.debet"            class="java.math.BigDecimal"/>
    <field name="row.credet"           class="java.math.BigDecimal"/>
    <field name="row.project"          class="java.lang.String"/>
    <field name="row.resultunit"       class="java.lang.String"/>


    <!-- The sum. -->
    <variable name="debet.sum" class="java.math.BigDecimal"  resetType="Report" calculation="Sum">
        <variableExpression>$F{row.debet}</variableExpression>
        <initialValueExpression>new BigDecimal(0.0) </initialValueExpression>
    </variable>

    <variable name="credet.sum" class="java.math.BigDecimal"  resetType="Report" calculation="Sum">
        <variableExpression>$F{row.credet}</variableExpression>
        <initialValueExpression>new BigDecimal(0.0) </initialValueExpression>
    </variable>


    <group name="invoiceTotals" minHeightToStartNewPage="100">
        <groupExpression><![CDATA[$P{invoice.number}]]></groupExpression>
        <groupFooter>
        <band height="80" isSplitAllowed="false">
            <!-- Voucher debit/credit totals, always after the final account row. -->
            <line><reportElement x="80" y="0" width="450" height="1"/></line>
            <textField>
                <reportElement x="80" y="2" width="250" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$R{invoicejournal.sum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="370" y="2" width="80" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{debet.sum}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="2" width="80" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{credet.sum}]]></textFieldExpression>
            </textField>

            <!-- Invoice totals belong to the subreport so they cannot overlap its rows. -->
            <textField><reportElement x="350" y="18" width="120" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$R{invoicejournal.sum}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="470" y="18" width="60" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{invoice.sum}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="33" width="120" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$R{invoicejournal.tax}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="470" y="33" width="60" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{invoice.tax}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="48" width="120" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$R{invoicejournal.currencyrate}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00000"><reportElement x="470" y="48" width="60" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{invoice.currencyrate}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="63" width="120" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$R{invoicejournal.totalsum}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="470" y="63" width="60" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression class="java.math.BigDecimal"><![CDATA[$P{invoice.localsum}]]></textFieldExpression></textField>
        </band>
        </groupFooter>
    </group>

    <detail>
        <band height="12" isSplitAllowed="true">

            <!-- Account number -->
            <textField  isBlankWhenNull="true">
                <reportElement x="80" y="0" width="40" height="12"/>
                <textElement>
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.lang.Integer">
                    <![CDATA[$F{row.account}]]>
                </textFieldExpression>
            </textField>

            <!-- Description -->
            <textField  isBlankWhenNull="true">
                <reportElement x="140" y="0" width="150" height="12"/>
                <textElement>
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$F{row.description}]]>
                </textFieldExpression>
            </textField>



            <!-- Project -->
            <textField  isBlankWhenNull="true">
                <reportElement x="270" y="0" width="50" height="12"/>
                <textElement textAlignment="Left">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{row.project}]]>
                </textFieldExpression>
            </textField>


            <!-- Result unit -->
            <textField isBlankWhenNull="true">
                <reportElement x="320" y="0" width="50" height="12"/>
                <textElement textAlignment="Left">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{row.resultunit}]]>
                </textFieldExpression>
            </textField>



            <!-- Debet -->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="370" y="0" width="80" height="12"/>
                <textElement textAlignment="Right">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal">
                    <![CDATA[$F{row.debet}]]>
                </textFieldExpression>
            </textField>


            <!-- Credet -->
            <textField pattern="#,##0.00"  isBlankWhenNull="true">
                <reportElement x="450" y="0" width="80" height="12"/>
                <textElement textAlignment="Right">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal">
                    <![CDATA[$F{row.credet}]]>
                </textFieldExpression>
            </textField>


        </band>
    </detail>




</jasperReport>