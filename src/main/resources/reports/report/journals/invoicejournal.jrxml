<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport name="InvoiceJournal" resourceBundle="book">

    <parameter name="Report"     class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="Parameters" class="java.util.HashMap"/>


    <!-- Declared fields in the report. -->

    <field name="invoice.number"            class="java.lang.Integer"/>

    <field name="invoice.customernr"          class="java.lang.String"/>
    <field name="invoice.customername"            class="java.lang.String"/>

    <field name="invoice.date"            class="java.lang.String"/>
    <field name="invoice.sum"             class="java.math.BigDecimal"/>
    <field name="invoice.tax"             class="java.math.BigDecimal"/>
    <field name="invoice.currency"        class="java.lang.String"/>
    <field name="invoice.currencyrate"    class="java.math.BigDecimal"/>
    <field name="invoice.localsum"        class="java.math.BigDecimal"/>


    <field name="journal.rows"     class="net.sf.jasperreports.engine.JRDataSource"/>


    <!-- The sum. -->
    <variable name="sum" class="java.math.BigDecimal"  resetType="Report" calculation="Sum">
        <variableExpression>
            <![CDATA[$F{invoice.localsum}]]>
        </variableExpression>
        <initialValueExpression>
            <![CDATA[new BigDecimal(0.0)]]>
        </initialValueExpression>
    </variable>


    <columnHeader>
        <band height="30">
            <line>
                <reportElement x="20" y="23" width="510" height="1"/>
            </line>

            <!-- Column 1 -->
            <textField>
                <reportElement x="20" y="0" width="80" height="24" />
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.1}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="0" width="80" height="24" />
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.2}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="140" y="0" width="70" height="24" />
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.3}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="270" y="0" width="50" height="24" />
                <textElement textAlignment="Left">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.4}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="320" y="0" width="50" height="24" />
                <textElement textAlignment="Left">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.5}]]>
                </textFieldExpression>
            </textField>

            <textField>
                <reportElement x="370" y="0" width="80" height="24" />
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.6}]]>
                </textFieldExpression>
            </textField>



            <textField>
                <reportElement x="450" y="0" width="80" height="24" />
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.column.7}]]>
                </textFieldExpression>
            </textField>


        </band>
    </columnHeader>


    <detail>
        <band height="170" isSplitAllowed="true">


            <!-- Invoice number -->
            <textField>
                <reportElement x="20" y="0" width="30" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.Integer">
                    <![CDATA[$F{invoice.number}]]>
                </textFieldExpression>
            </textField>

            <!-- Customer number -->
            <textField>
                <reportElement x="80" y="0" width="80" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{invoice.customernr}]]>
                </textFieldExpression>
            </textField>

            <!-- Customer name -->
            <textField>
                <reportElement x="140" y="0" width="150" height="14"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{invoice.customername}]]>
                </textFieldExpression>
            </textField>

            <!-- Invoice date -->
            <textField>
                <reportElement x="370" y="0" width="80" height="14"/>
                <textElement  textAlignment="Right">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{invoice.date}]]>
                </textFieldExpression>
            </textField>


            <!-- Invoice currency -->
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="0" width="80" height="14"/>
                <textElement  textAlignment="Right">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$F{invoice.currency}]]>
                </textFieldExpression>
            </textField>


            <!-- Order rows -->
            <subreport isUsingCache="false">
                <reportElement x="0" y="12" width="555" height="158" isPrintWhenDetailOverflows="true"/>

                <subreportParameter name="invoice.customernr">
                    <subreportParameterExpression>
                        <![CDATA[$F{invoice.number}]]>
                    </subreportParameterExpression>
                </subreportParameter>

                <subreportParameter name="invoice.sum">
                    <subreportParameterExpression><![CDATA[$F{invoice.sum}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="invoice.tax">
                    <subreportParameterExpression><![CDATA[$F{invoice.tax}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="invoice.currencyrate">
                    <subreportParameterExpression><![CDATA[$F{invoice.currencyrate}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="invoice.localsum">
                    <subreportParameterExpression><![CDATA[$F{invoice.localsum}]]></subreportParameterExpression>
                </subreportParameter>

                <dataSourceExpression>
                    <![CDATA[$F{journal.rows}]]>
                </dataSourceExpression>

                <subreportExpression class="net.sf.jasperreports.engine.JasperReport">
                    <![CDATA[$P{Report}]]>
                </subreportExpression>
            </subreport>



        </band>
    </detail>


    <summary>
        <band height="20">

            <rectangle>
                <reportElement x="20" y="0" width="510" height="2" backcolor="#000000"/>
                <graphicElement pen="None" fill="Solid"/>
            </rectangle>

            <textField>
                <reportElement x="20" y="2" width="250" height="14"/>
                <textElement>
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.lang.String">
                    <![CDATA[$R{invoicejournal.totalsum}]]>
                </textFieldExpression>
            </textField>


            <!-- Total sum-->
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="450" y="2" width="80" height="14"/>

                <textElement textAlignment="Right">
                    <font size="8" isBold="false"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal">
                    <![CDATA[$V{sum} != null ? $V{sum} : new BigDecimal(0.0)]]>
                </textFieldExpression>
            </textField>
        </band>
    </summary>


</jasperReport>