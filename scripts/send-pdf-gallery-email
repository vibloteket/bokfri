#!/usr/bin/env bash
set -euo pipefail

required=(SMTP_SERVER SMTP_PORT SMTP_USERNAME SMTP_PASSWORD EMAIL_FROM EMAIL_TO GALLERY_DIR)
for name in "${required[@]}"; do
  if [[ -z ${!name:-} ]]; then
    echo "Skipping PDF gallery email: $name is not configured."
    exit 0
  fi
done

if [[ ! -d $GALLERY_DIR ]]; then
  echo "PDF gallery directory does not exist: $GALLERY_DIR" >&2
  exit 1
fi

mapfile -t reports < <(find "$GALLERY_DIR" -mindepth 2 -maxdepth 2 -type f \
  -name 'page-*.png' ! -name '*-diff.png' -printf '%h\n' | sort -u)
if [[ ${#reports[@]} -eq 0 ]]; then
  echo "PDF gallery contains no page images." >&2
  exit 1
fi

attachments=()
report_summaries=()
for report_dir in "${reports[@]}"; do
  mapfile -t pages < <(find "$report_dir" -maxdepth 1 -type f -name 'page-*.png' \
    ! -name '*-diff.png' -printf '%f\n' | sort -V)
  page_count=${#pages[@]}
  selected_pages=()
  if ((page_count <= 3)); then
    selected_pages=("${pages[@]}")
  else
    middle=$(((page_count + 1) / 2))
    selected_pages=("${pages[0]}" "${pages[middle - 1]}" "${pages[page_count - 1]}")
  fi
  report=${report_dir#"$GALLERY_DIR"/}
  selected_numbers=()
  for page in "${selected_pages[@]}"; do
    attachments+=("$report_dir/$page")
    number=${page#page-}
    selected_numbers+=("${number%.png}")
  done
  selected_text=$(IFS=,; printf '%s' "${selected_numbers[*]}")
  report_summaries+=("$report|$page_count|$selected_text")
done

message=$(mktemp)
trap 'rm -f "$message"' EXIT
boundary="bokfri-gallery-$(date +%s)-${RANDOM}"
actions_url=${ACTIONS_URL:-}
pr_url=${PR_URL:-}
commit=${COMMIT_SHA:-unknown}
short_commit=${commit:0:7}
pr_number=${PR_NUMBER:-unknown}
subject=${EMAIL_SUBJECT:-[Bokfri PDF] PR #${pr_number} - ${short_commit}}

{
  printf 'From: Bokfri CI <%s>\r\n' "$EMAIL_FROM"
  printf 'To: %s\r\n' "$EMAIL_TO"
  printf 'Subject: %s\r\n' "$subject"
  printf 'MIME-Version: 1.0\r\n'
  printf 'Content-Type: multipart/mixed; boundary="%s"\r\n' "$boundary"
  printf '\r\n--%s\r\n' "$boundary"
  printf 'Content-Type: text/plain; charset=UTF-8\r\n'
  printf 'Content-Transfer-Encoding: 8bit\r\n\r\n'
  printf 'Bokfri PDF gallery generated successfully.\r\n\r\n'
  printf 'Reports and attached pages:\r\n'
  for summary in "${report_summaries[@]}"; do
    IFS='|' read -r report page_count selected_text <<< "$summary"
    if ((page_count <= 3)); then
      printf -- '- %s: all %d page(s) attached\r\n' "$report" "$page_count"
    else
      printf -- '- %s: %d pages; attached pages %s\r\n' \
        "$report" "$page_count" "$selected_text"
    fi
  done
  printf '\r\nCommit: %s\r\n' "$commit"
  [[ -z $pr_url ]] || printf 'Pull request: %s\r\n' "$pr_url"
  [[ -z $actions_url ]] || printf 'GitHub Actions: %s\r\n' "$actions_url"
  printf '\r\nAll PDFs and rendered pages remain available in the GitHub artifact.\r\n'

  for attachment in "${attachments[@]}"; do
    relative=${attachment#"$GALLERY_DIR"/}
    filename=${relative//\//-}
    content_type='image/png'
    printf '\r\n--%s\r\n' "$boundary"
    printf 'Content-Type: %s; name="%s"\r\n' "$content_type" "$filename"
    printf 'Content-Disposition: attachment; filename="%s"\r\n' "$filename"
    printf 'Content-Transfer-Encoding: base64\r\n\r\n'
    base64 -w 76 "$attachment" | sed 's/$/\r/'
  done
  printf '\r\n--%s--\r\n' "$boundary"
} > "$message"

curl --fail-with-body --silent --show-error \
  --url "smtp://${SMTP_SERVER}:${SMTP_PORT}" \
  --ssl-reqd \
  --user "${SMTP_USERNAME}:${SMTP_PASSWORD}" \
  --mail-from "$EMAIL_FROM" \
  --mail-rcpt "$EMAIL_TO" \
  --upload-file "$message"

echo "Sent PDF gallery email to $EMAIL_TO with ${#attachments[@]} attachments."
