#!/usr/bin/env bash
set -euo pipefail

root=${1:-src/main/java}
output=${2:-docs/report-templates.md}
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

{
  echo '# Report templates'
  echo
  echo 'The canonical report source tree is `src/main/resources/reports/report/`.'
  echo 'Templates are compiled from packaged classpath resources at runtime; compiled cache files'
  echo 'under the user data directory are generated artifacts and are not source files.'
  echo
  echo 'This table is generated by `./scripts/report-template-map` from literal report setter calls.'
  echo
  echo '| Java printer | Referenced JRXML templates |'
  echo '|---|---|'

  find "$root" -type f -name '*.java' -print0 | sort -z | while IFS= read -r -d '' file; do
    refs=$(sed -E 's,//.*$,,' "$file" \
      | grep -oE 'set(PageHeader|PageFooter|ColumnHeader|ColumnFooter|Detail|Summary|Background|LastPageFooter)\("[^"]+\.jrxml"\)' \
      | sed -E 's/^[^(]+\("([^"]+)"\)$/`\1`/' | sort -u \
      | awk 'BEGIN { first=1 } { if (!first) printf "<br>"; printf "%s", $0; first=0 } END { print "" }' || true)
    if [[ -n "$refs" ]]; then
      class=${file#src/main/java/}
      class=${class%.java}
      class=${class//\//.}
      printf '| `%s` | %s |\n' "$class" "$refs"
    fi
  done
} >"$tmp"

mkdir -p "$(dirname "$output")"
mv "$tmp" "$output"
trap - EXIT
